<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
<title>EDUNEST Placement Checker</title>
<style>
:root { --navy:#0A1A45; --red:#C8102E; --ok:#15803D; --bad:#B91C1C; --warn:#B45309; --line:#E5E7EB; --muted:#6B7280; }
* { box-sizing:border-box; -webkit-tap-highlight-color:transparent; }
body { margin:0; font-family:Inter, system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif; color:#111827; background:#F3F4F6; }
header { background:#fff; border-bottom:3px solid var(--navy); padding:10px 14px; display:flex; align-items:center; gap:12px; position:sticky; top:0; z-index:5; }
header img { height:34px; }
header .t { margin-left:auto; text-align:right; }
header .t b { display:block; font-size:15px; color:var(--navy); letter-spacing:.5px; }
header .t span { font-size:11px; color:var(--muted); letter-spacing:1.5px; font-weight:700; }
main { max-width:720px; margin:0 auto; padding:14px; }
.card { background:#fff; border-radius:14px; padding:16px; margin-bottom:14px; box-shadow:0 1px 2px rgba(0,0,0,.06); }
h2 { margin:0 0 6px; font-size:20px; color:var(--navy); }
p { margin:6px 0; line-height:1.45; }
.muted { color:var(--muted); font-size:14px; }
.btn { display:flex; align-items:center; justify-content:center; gap:10px; width:100%; min-height:58px; border:0; border-radius:12px; font-size:17px; font-weight:700;
       background:var(--navy); color:#fff; margin:10px 0 0; cursor:pointer; text-decoration:none; }
.btn.red { background:var(--red); }
.btn.ghost { background:#fff; color:var(--navy); border:2px solid var(--navy); }
.btn.small { min-height:46px; font-size:15px; }
.btn svg { width:24px; height:24px; }
.row2 { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
.steps { display:flex; gap:8px; margin:4px 0 10px; }
.steps div { flex:1; height:6px; border-radius:3px; background:var(--line); }
.steps div.on { background:var(--red); }
.photo { width:100%; border-radius:10px; display:block; background:#111; }
.chips { display:grid; grid-template-columns:repeat(4, minmax(0,1fr)); gap:8px; margin-top:12px; }
.chip { border:2px solid var(--line); border-radius:10px; padding:8px 4px; text-align:center; font-weight:800; font-size:15px; background:#fff; cursor:pointer; user-select:none; }
.chip small { display:block; font-weight:600; font-size:11px; color:var(--muted); }
.chip.ok { border-color:var(--ok); background:#F0FDF4; }
.chip.bad { border-color:var(--bad); background:#FEF2F2; }
.chip.warn { border-color:var(--warn); background:#FFFBEB; }
.score { display:grid; grid-template-columns:repeat(4, minmax(0,1fr)); gap:8px; margin-top:10px; }
.score div { background:#F9FAFB; border:1px solid var(--line); border-radius:10px; padding:8px; text-align:center; font-size:12px; color:var(--muted); font-weight:700; }
.score div b { display:block; font-size:22px; color:#111827; }
.score div.tot { border:2px solid var(--red); }
.badge { display:inline-block; padding:5px 10px; border-radius:999px; font-weight:800; font-size:13px; }
.b-acc { background:#DCFCE7; color:#166534; } .b-call { background:#FEF3C7; color:#92400E; } .b-no { background:#FEE2E2; color:#991B1B; }
.alert { border-radius:10px; padding:10px 12px; font-weight:600; margin-top:10px; }
.alert.warn { background:#FFFBEB; border:1px solid #FCD34D; color:#92400E; }
.alert.err { background:#FEF2F2; border:1px solid #FCA5A5; color:#991B1B; }
.alert.ok { background:#F0FDF4; border:1px solid #86EFAC; color:#166534; }
input[type=text] { width:100%; min-height:50px; border:2px solid var(--line); border-radius:10px; padding:10px 12px; font-size:17px; margin-top:8px; }
.nameimg { width:100%; border:1px solid var(--line); border-radius:8px; background:#fff; display:block; margin-top:8px; }
table.res { width:100%; border-collapse:collapse; font-size:14px; }
table.res th { text-align:left; font-size:11px; color:var(--muted); letter-spacing:.6px; padding:6px 4px; border-bottom:2px solid #111827; }
table.res td { padding:8px 4px; border-bottom:1px solid var(--line); vertical-align:middle; }
table.res td.n { font-weight:800; }
table.res img { height:26px; max-width:120px; display:block; }
.picker { position:fixed; inset:0; background:rgba(0,0,0,.45); display:flex; align-items:flex-end; z-index:20; }
.picker .sheet { background:#fff; width:100%; border-radius:16px 16px 0 0; padding:16px; }
.picker .opts { display:grid; grid-template-columns:repeat(4,1fr); gap:10px; margin-top:12px; }
.picker .opts button { min-height:60px; font-size:20px; font-weight:800; border-radius:12px; border:2px solid var(--navy); background:#fff; color:var(--navy); }
.busy { text-align:center; padding:30px 10px; font-weight:700; color:var(--navy); }
.spin { width:38px; height:38px; border:4px solid var(--line); border-top-color:var(--red); border-radius:50%; margin:0 auto 12px; animation:sp 0.9s linear infinite; }
@keyframes sp { to { transform:rotate(360deg); } }
</style>
