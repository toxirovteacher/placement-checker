function ranked() { return load().sort((a, b) => b.T - a.T || b.G - a.G || String(a.name).localeCompare(String(b.name))); }
function pick(q) {
  const d = document.createElement('div'); d.className = 'picker';
  d.innerHTML = `<div class="sheet"><b style="font-size:18px">Question ${q}</b> <span class="muted">(key: ${KEY[q]})</span>
    <div class="opts">${['A', 'B', 'C', ''].map(x => `<button data-v="${x}">${x || 'Empty'}</button>`).join('')}</div>
    <button class="btn ghost small" data-v="cancel">Cancel</button></div>`;
  d.onclick = ev => { const v = ev.target.dataset && ev.target.dataset.v; if (v === undefined && ev.target !== d) return;
    if (v !== undefined && v !== 'cancel') { cur.answers[q] = v || null; cur.flags[q] = v ? '' : 'blank'; }
    d.remove(); if (v !== undefined && v !== 'cancel') render(); };
  document.body.appendChild(d);
}
function download(blob, name) { const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = name; document.body.appendChild(a); a.click(); setTimeout(() => { URL.revokeObjectURL(a.href); a.remove(); }, 1500); }
function csv() {
  const rows = [['Rank', 'Name', 'Listening /12', 'Reading /12', 'Grammar /16', 'Total /40', 'Level', 'Decision', 'Checked', 'Answers 1-40']];
  ranked().forEach((r, i) => { const b = band(r.T); rows.push([i + 1, r.name || '', r.L, r.R, r.G, r.T, b.level, b.decision, r.date, r.answers]); });
  const txt = '﻿' + rows.map(r => r.map(v => `"${String(v).replace(/"/g, '""')}"`).join(',')).join('\r\n');
  download(new Blob([txt], { type: 'text/csv' }), 'EDUNEST-placement-results.csv');
}
async function jpg() {
  const list = ranked(), W = 1080, rowH = 64, top = 190, Hh = top + list.length * rowH + 70, c = document.createElement('canvas');
  c.width = W; c.height = Hh; const x = c.getContext('2d');
  x.fillStyle = '#fff'; x.fillRect(0, 0, W, Hh);
  x.fillStyle = '#0A1A45'; x.fillRect(0, 0, W, 150);
  try { const lg = await loadImg(document.querySelector('header img').src); x.fillStyle = '#fff'; x.fillRect(40, 35, 260, 82); x.drawImage(lg, 52, 44, 236, 64); } catch (e) {}
  x.fillStyle = '#fff'; x.font = '800 40px Montserrat, Inter, Arial'; x.textAlign = 'right'; x.fillText('PLACEMENT TEST RESULTS', W - 40, 82);
  x.font = '500 22px Inter, Arial'; x.fillText('Multi Level · ' + new Date().toLocaleDateString(), W - 40, 118);
  x.textAlign = 'left'; x.fillStyle = '#6B7280'; x.font = '700 18px Inter, Arial';
  [['#', 40], ['STUDENT', 100], ['L', 640], ['R', 700], ['G', 760], ['TOTAL', 830], ['LEVEL', 930]].forEach(([t, px]) => x.fillText(t, px, top - 14));
  for (let i = 0; i < list.length; i++) {
    const r = list[i], y = top + i * rowH, b = band(r.T);
    if (i % 2 === 0) { x.fillStyle = '#F9FAFB'; x.fillRect(30, y, W - 60, rowH); }
    x.fillStyle = '#111827'; x.font = '800 24px Inter, Arial'; x.fillText(String(i + 1), 40, y + 41);
    if (r.name) { x.font = '700 24px Inter, Arial'; x.fillText(r.name.slice(0, 32), 100, y + 41); }
    else if (r.nameImg) { try { const im = await loadImg(r.nameImg); x.drawImage(im, 100, y + 6, Math.min(500, im.width * (52 / im.height)), 52); } catch (e) {} }
    x.font = '600 24px Inter, Arial'; x.fillText(String(r.L), 640, y + 41); x.fillText(String(r.R), 700, y + 41); x.fillText(String(r.G), 760, y + 41);
    x.font = '800 26px Inter, Arial'; x.fillText(String(r.T), 840, y + 41);
    x.font = '700 18px Inter, Arial'; x.fillStyle = b.cls === 'b-acc' ? '#166534' : b.cls === 'b-call' ? '#92400E' : '#991B1B'; x.fillText(b.level, 930, y + 40);
  }
  x.fillStyle = '#9CA3AF'; x.font = '500 18px Inter, Arial'; x.fillText('EDUNEST Academy · Placement checker', 40, Hh - 28);
  c.toBlob(bl => download(bl, 'EDUNEST-placement-results.jpg'), 'image/jpeg', 0.92);
}
cam.onchange = async () => {
  const f = cam.files && cam.files[0]; if (!f) return;
  const want = cur.step; go('busy');
  try {
    const url = URL.createObjectURL(f), im = await loadImg(url), c = toCanvas(im, 1800); URL.revokeObjectURL(url);
